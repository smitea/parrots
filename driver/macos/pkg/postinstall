#!/bin/bash
# ParrotsAudio.pkg postinstall script (runs as root)
# The drivers land in /Library/Audio/Plug-Ins/HAL/ via the payload; fix permissions here and restart CoreAudio.
chown -R root:wheel /Library/Audio/Plug-Ins/HAL/ParrotsMicrophone.driver \
                    /Library/Audio/Plug-Ins/HAL/ParrotsSpeakers.driver 2>/dev/null || true
chmod -R 755 /Library/Audio/Plug-Ins/HAL/ParrotsMicrophone.driver \
             /Library/Audio/Plug-Ins/HAL/ParrotsSpeakers.driver 2>/dev/null || true
killall coreaudiod || true
exit 0
